# --- API (apps/api/.env) ---
MONGO_URI=mongodb://localhost:27017/mente-ativa
# Em produção é obrigatório e precisa ter 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret
# Porta HTTP. O Render injeta PORT; API_PORT é o fallback local.
PORT=
API_PORT=3000
# development | test | production. Em production, POST /demo/reset responde 404 e o seed de demo é bloqueado.
NODE_ENV=development
# Nível de log do pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Origens liberadas no CORS, separadas por vírgula.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Usado apenas por `npm run create-admin` (mínimo 12 caracteres).
ADMIN_PASSWORD=

# --- Assinaturas (Stripe) ---
# URL do web: base do success_url/cancel_url do Checkout, do return_url do Portal e dos links nos e-mails.
APP_URL=http://localhost:5173
# Sem STRIPE_SECRET_KEY as rotas /billing/* respondem 503 (o resto da API funciona).
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_...). Local: o `stripe listen` mostra o valor.
STRIPE_WEBHOOK_SECRET=
# IDs dos preços do produto "Mente Ativa": R$ 49,90/mês e R$ 538,92/ano.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# --- E-mail (SMTP) ---
# Sem SMTP_HOST os e-mails só são registrados no log. Resend: smtp.resend.com, 465, usuário "resend".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mente Ativa <acesso@menteativaa.com.br>"

# --- Web (lidas em tempo de build pelo Vite) ---
VITE_API_URL=http://localhost:3000/api/v1
