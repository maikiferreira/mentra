# --- API (apps/api/.env) ---
MONGO_URI=mongodb://localhost:27017/mente-ativa
# Em produção é obrigatório e precisa ter 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret
# Porta HTTP. O Render injeta PORT; API_PORT é o fallback local.
PORT=
API_PORT=3000
# development | test | production. Em production, POST /demo/reset responde 404 e o seed de demo é bloqueado.
NODE_ENV=development
# Nível de log do pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Origens liberadas no CORS, separadas por vírgula.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Usado apenas por `npm run create-admin` (mínimo 12 caracteres).
ADMIN_PASSWORD=

# --- Assinaturas (Eduzz) ---
# URL do web: base dos links nos e-mails.
APP_URL=http://localhost:5173
# Sem nenhuma variável EDUZZ_* as rotas /billing/* respondem 503 (o resto da API funciona).
# Links de checkout de cada plano (R$ 49,90/mês e R$ 538,92/ano).
EDUZZ_CHECKOUT_MONTHLY=
EDUZZ_CHECKOUT_ANNUAL=
# IDs dos produtos na Eduzz: dizem ao webhook se a compra é mensal ou anual.
EDUZZ_PRODUCT_MONTHLY=
EDUZZ_PRODUCT_ANNUAL=
# Chave gerada em console.eduzz.com > Webhook > Segurança (valida o x-signature).
EDUZZ_WEBHOOK_SECRET=
# Área do comprador, onde ele troca o cartão e cancela.
EDUZZ_CUSTOMER_AREA_URL=https://orbita.eduzz.com

# --- E-mail (SMTP) ---
# Sem SMTP_HOST os e-mails só são registrados no log. Resend: smtp.resend.com, 465, usuário "resend".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mente Ativa <acesso@menteativaa.com.br>"

# --- Web (lidas em tempo de build pelo Vite) ---
VITE_API_URL=http://localhost:3000/api/v1
